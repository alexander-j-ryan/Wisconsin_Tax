    <worksheet name='Key -EV'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Equalized Value Used for Calendar Year</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CMRE DATA (CMRE ALL YEARS)' name='federated.0n0eo4314xp6n615omggs19j8yeo' />
            <datasource caption='EV (CMRE ALL YEARS)' name='federated.0j4tcur0yc5l741a4b4hy16cfzrf' />
          </datasources>
          <datasource-dependencies datasource='federated.0j4tcur0yc5l741a4b4hy16cfzrf'>
            <column caption='% Change EV' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([EV TID-IN])) - LOOKUP(ZN(SUM([EV TID-IN])), -1)) / ABS(LOOKUP(ZN(SUM([EV TID-IN])), -1))'>
                <table-calc ordering-type='Columns' />
              </calculation>
            </column>
            <column caption='Join Code' datatype='string' name='[Calculation_825003219799109633]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[County Code]+[Muni Code 2]' />
            </column>
            <column caption='T/F % Change EV' datatype='boolean' name='[Calculation_825003219800047618]' role='measure' type='nominal'>
              <calculation class='tableau' formula='(ZN(SUM([EV TID-IN])) - LOOKUP(ZN(SUM([EV TID-IN])), -1)) / ABS(LOOKUP(ZN(SUM([EV TID-IN])), -1))&gt;0'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[County Code]' role='dimension' semantic-role='[County].[Name]' type='nominal' />
            <column caption='Ev Tid-In' datatype='integer' name='[EV TID-IN]' role='measure' type='quantitative' />
            <column datatype='string' name='[Muni Code 2]' role='dimension' type='nominal' />
            <column datatype='date' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[EV TID-IN]' derivation='Sum' name='[sum:EV TID-IN:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation1]' derivation='User' name='[usr:Calculation1:ok]' pivot='key' type='ordinal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_825003219800047618]' derivation='User' name='[usr:Calculation_825003219800047618:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0n0eo4314xp6n615omggs19j8yeo'>
            <column caption='Political Subdivision' datatype='string' name='[Calculation_558446414366490624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Muni Type Code]+&quot; of &quot;+[Municipality]+&quot; (&quot;+[County Name]+&quot;)&quot;' />
