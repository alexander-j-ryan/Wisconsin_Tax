      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0n0eo4314xp6n615omggs19j8yeo].[usr:Calculation1:qk:2]&quot;' value='Share of Total (%)' />
        </aliases>
      </column>
      <column caption='% of Total' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Pivot Field Values]) / TOTAL(SUM([Pivot Field Values]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Change' datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Pivot Field Values])) - LOOKUP(ZN(SUM([Pivot Field Values])), -1)) / ABS(LOOKUP(ZN(SUM([Pivot Field Values])), -1))'>
          <table-calc ordering-field='[federated.0n0eo4314xp6n615omggs19j8yeo].[tyr:Year:ok]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='% Change Population' datatype='real' default-format='p0.00%' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Population])) - LOOKUP(ZN(SUM([Population])), -1)) / ABS(LOOKUP(ZN(SUM([Population])), -1))'>
          <table-calc ordering-field='[federated.0n0eo4314xp6n615omggs19j8yeo].[tyr:Year:ok]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Debt Per Capita Rank' datatype='integer' name='[Calculation4]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_386183728377438208]))'>
          <table-calc ordering-type='Field'>
            <order field='[federated.0n0eo4314xp6n615omggs19j8yeo].[none:Calculation_558446414366490624:nk]' />
            <order field='[federated.0n0eo4314xp6n615omggs19j8yeo].[none:County Name:nk]' />
          </table-calc>
        </calculation>
      </column>
      <column caption='Debt Rank' datatype='integer' name='[Calculation5]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Pivot Field Values]))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='% Change Tax Rate' datatype='real' default-format='p0.00%' name='[Calculation6]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_1259882059205742592]) - LOOKUP(ZN([Calculation_1259882059205742592]), -1)) / ABS(LOOKUP(ZN([Calculation_1259882059205742592]), -1))'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Map Rank' datatype='integer' name='[Calculation7]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Calculation_386183728377438208]))'>
          <table-calc ordering-field='[federated.0n0eo4314xp6n615omggs19j8yeo].[Calculation_558446414366490624]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Tax Rate (mills)' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1259882059205742592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([federated.0j4tcur0yc5l741a4b4hy16cfzrf].[Local Taxes (SOT TVC or County)])/SUM([federated.0j4tcur0yc5l741a4b4hy16cfzrf].[EV TID-OUT])*1000' />
      </column>
      <column caption='Change T/F Tax Rate' datatype='boolean' name='[Calculation_1259882059206782978]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN([Calculation_1259882059205742592]) - LOOKUP(ZN([Calculation_1259882059205742592]), -1)) / ABS(LOOKUP(ZN([Calculation_1259882059205742592]), -1))&gt;0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Per Capita Amount' datatype='real' default-format='c&quot;$&quot;#,##0.00;(&quot;$&quot;#,##0.00)' name='[Calculation_386183728377438208]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Pivot Field Values]/[Population]' />
      </column>
      <column caption='Change T/F Metric' datatype='boolean' name='[Calculation_402227802637250562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation2]&gt;0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Change T/F Population' datatype='boolean' name='[Calculation_402227802741194756]' role='measure' type='nominal'>
        <calculation class='tableau' formula='(ZN(SUM([Population])) - LOOKUP(ZN(SUM([Population])), -1)) / ABS(LOOKUP(ZN(SUM([Population])), -1))&gt;0'>
